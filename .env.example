# Copy this file to .env and fill in real values. Never commit .env.

# Required for answering questions and for the faithfulness eval
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Optional: GitHub token raises the API rate limit used for repo size checks
GITHUB_TOKEN=

# Where cloned repos and indexes are stored
REPORAG_DATA_DIR=./data

# Indexing limits
REPORAG_MAX_REPO_MB=50
REPORAG_MAX_FILES=2000
REPORAG_MAX_FILE_KB=200

# Retrieval device: auto | mps | cuda | cpu
REPORAG_DEVICE=auto

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
